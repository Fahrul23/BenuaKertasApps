# ===================================
# Benua Kertas Server - Environment
# ===================================

# Database
DATABASE_URL=mysql://user:password@localhost:3306/db_cetak

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password

# Upload
UPLOAD_DIR=uploads
