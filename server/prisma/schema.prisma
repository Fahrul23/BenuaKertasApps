generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int            @id @default(autoincrement())
  name                String         @db.VarChar(100)
  email               String         @unique @db.VarChar(255)
  password            String         @db.VarChar(255)
  role                users_role     @default(USER)
  createdAt           DateTime       @default(now())
  resetPasswordExpiry DateTime?
  resetPasswordToken  String?        @db.VarChar(255)
  order_history       OrderHistory[]
  orders              Order[]
  payments            payments[]

  @@map("users")
}

// ==========================================
// Master Data Tables
// ==========================================

model BoxModel {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(200)
  description String?   @db.Text
  imageUrl    String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  basePrice   Decimal?  @db.Decimal(15, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("box_models")
}

model Material {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(100)
  name         String    @db.VarChar(200)
  description  String?   @db.Text
  imageUrl     String?   @db.VarChar(500)
  isActive     Boolean   @default(true)
  price300gsm  Decimal?  @db.Decimal(15, 2)
  price350gsm  Decimal?  @db.Decimal(15, 2)
  price400gsm  Decimal?  @db.Decimal(15, 2)
  price450gsm  Decimal?  @db.Decimal(15, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("materials")
}

model FinishingOption {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(100)
  name            String    @db.VarChar(200)
  description     String?   @db.Text
  imageUrl        String?   @db.VarChar(500)
  isActive        Boolean   @default(true)
  additionalPrice Decimal?  @db.Decimal(15, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("finishing_options")
}

model PricingRule {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(200)
  minQuantity     Int
  maxQuantity     Int?
  minTotalArea    Decimal?  @db.Decimal(15, 2)
  maxTotalArea    Decimal?  @db.Decimal(15, 2)
  pricePerUnit    Decimal   @db.Decimal(15, 2)
  discountPercent Decimal?  @db.Decimal(5, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([minQuantity])
  @@index([isActive])
  @@map("pricing_rules")
}

model Order {
  id                      Int                  @id @default(autoincrement())
  orderNumber             String               @unique @db.VarChar(50)
  userId                  Int
  boxModel                String               @db.VarChar(50)
  sizePanjang             Decimal              @db.Decimal(10, 2)
  sizeLebar               Decimal              @db.Decimal(10, 2)
  sizeTinggi              Decimal              @db.Decimal(10, 2)
  sizeTinggiTutup         Decimal?             @db.Decimal(10, 2)
  material                String               @db.VarChar(50)
  materialThickness       Int
  colorOption             String               @db.VarChar(50)
  finishingOption         String               @db.VarChar(50)
  designFileUrl           String?              @db.VarChar(500)
  designFilePublicId      String?              @db.VarChar(255)
  designFileName          String?              @db.VarChar(255)
  designFileSize          Int?
  designFileFormat        String?              @db.VarChar(10)
  customerNote            String?              @db.Text
  quantity                Int
  subtotal                Decimal              @db.Decimal(15, 2)
  tax                     Decimal              @default(0.00) @db.Decimal(15, 2)
  totalAmount             Decimal              @db.Decimal(15, 2)
  orderStatus             orders_orderStatus   @default(PENDING)
  paymentStatus           orders_paymentStatus @default(UNPAID)
  estimatedProductionDays Int                  @default(10)
  productionStartDate     DateTime?            @db.Date
  productionEndDate       DateTime?            @db.Date
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  orderHistories          OrderHistory[]
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments                payments[]

  @@index([userId])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderHistory {
  id             Int                      @id @default(autoincrement())
  orderId        Int
  previousStatus String?                  @db.VarChar(50)
  newStatus      String                   @db.VarChar(50)
  changedBy      Int?
  changeType     order_history_changeType
  notes          String?                  @db.Text
  createdAt      DateTime                 @default(now())
  users          User?                    @relation(fields: [changedBy], references: [id])
  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@index([changedBy], map: "order_history_changedBy_fkey")
  @@map("order_history")
}

model bank_accounts {
  id                Int      @id @default(autoincrement())
  bankName          String   @db.VarChar(100)
  accountNumber     String   @db.VarChar(50)
  accountHolderName String   @db.VarChar(100)
  branch            String?  @db.VarChar(100)
  isActive          Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([isActive])
}

model categories {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  createdAt DateTime   @default(now())
  products  products[]
}

model custom_orders {
  id          Int                  @id @default(autoincrement())
  name        String               @db.VarChar(100)
  email       String               @db.VarChar(255)
  phone       String               @db.VarChar(20)
  productType String               @db.VarChar(100)
  quantity    Int
  notes       String?              @db.Text
  fileUrl     String?              @db.VarChar(500)
  status      custom_orders_status @default(PENDING)
  createdAt   DateTime             @default(now())
}

model galleries {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  image     String   @db.VarChar(500)
  productId Int
  createdAt DateTime @default(now())
  products  products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model payments {
  id                   Int                    @id @default(autoincrement())
  orderId              Int
  paymentNumber        String                 @unique @db.VarChar(50)
  paymentMethod        payments_paymentMethod
  bankName             String?                @db.VarChar(100)
  accountNumber        String?                @db.VarChar(50)
  accountHolderName    String?                @db.VarChar(100)
  amount               Decimal                @db.Decimal(15, 2)
  paymentProofUrl      String?                @db.VarChar(500)
  paymentProofPublicId String?                @db.VarChar(255)
  paymentProofName     String?                @db.VarChar(255)
  paymentStatus        payments_paymentStatus @default(PENDING)
  verifiedBy           Int?
  verifiedAt           DateTime?
  rejectionReason      String?                @db.Text
  paidAt               DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  orders               Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  users                User?                  @relation(fields: [verifiedBy], references: [id])

  @@index([orderId])
  @@index([paymentNumber])
  @@index([paymentStatus])
  @@index([verifiedBy], map: "payments_verifiedBy_fkey")
}

model products {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(200)
  slug        String      @unique @db.VarChar(220)
  description String?     @db.Text
  image       String?     @db.VarChar(500)
  categoryId  Int
  createdAt   DateTime    @default(now())
  galleries   galleries[]
  categories  categories  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

enum payments_paymentMethod {
  BANK_TRANSFER
  E_WALLET
  CREDIT_CARD
  CASH
}

enum users_role {
  ADMIN
  USER
}

enum order_history_changeType {
  STATUS_CHANGE
  PAYMENT_UPDATE
  PRODUCTION_UPDATE
  SHIPPING_UPDATE
  OTHER
}

enum custom_orders_status {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum payments_paymentStatus {
  PENDING
  VERIFIED
  REJECTED
  REFUNDED
}

enum orders_orderStatus {
  PENDING
  WAITING_PAYMENT
  PAYMENT_CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum orders_paymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}
